{
  "$schema": "./configs.schema.json",
  "conversation_language": "en",
  "documents_and_artifacts_language": "en",
  "mode": "expert-advisor",
  "user_expert_level": "beginner-friendly",
  "delegation_systems": {
    "native_task": true,
    "delegate_task": false,
    "background_delegation": false
  },
  "parallelization": false,
  "atomic_commit": true,
  "commit_docs": true,
  "workflow": {
    "research": true,
    "plan_check": true,
    "verifier": true,
    "discuss_mode": "intensive-phase-discussion",
    "research_before_questions": true,
    "use_worktrees": false,
    "intent_lock": {
      "enabled": false
    }
  },
  "behavioral": {
    "guardrail_level": "permissive",
    "delegation_mode": "waiter",
    "tool_access_pattern": "standard",
    "skill_filter": "curated",
    "communication_style": "detailed",
    "decision_speed": "deliberate",
    "expertise": "junior"
  },
  "description": "Beginner-friendly with maximum guidance. Curated skills, strict guardrails."
}